<Window x:Class="TodoTimer.Views.TimerPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="计时面板" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI">
    <Border CornerRadius="10" Background="#FFFFFF" BorderBrush="#E3E6EC" BorderThickness="1">
        <StackPanel>
            <!-- 标题栏（拖动移动；位置持久化） -->
            <Border Background="#2BA245" CornerRadius="10,10,0,0" Padding="12,8"
                    MouseLeftButtonDown="Header_DragMove">
                <TextBlock Text="⏱ 计时面板" Foreground="White" FontWeight="Bold" FontSize="13"/>
            </Border>
            <ItemsControl x:Name="PanelList" Margin="8,6,8,2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F5F6FA" CornerRadius="6" Padding="8,6" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Text}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="#1F2329"/>
                                <TextBlock x:Name="TimeLbl" Tag="time" Grid.Column="1" FontSize="12"
                                           Foreground="#2BA245" VerticalAlignment="Center" Margin="6,0"/>
                                <Button x:Name="ToggleBtn" Grid.Column="2" Width="24" Height="22"
                                        Click="Toggle_Click" Cursor="Hand"/>
                                <Button Grid.Column="3" Content="✕" Width="22" Height="22"
                                        Click="Remove_Click" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#B0B6BF"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Running}" Value="True">
                                <Setter TargetName="ToggleBtn" Property="Content" Value="⏸"/>
                                <Setter TargetName="TimeLbl" Property="Foreground" Value="#2BA245"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Running}" Value="False">
                                <Setter TargetName="ToggleBtn" Property="Content" Value="▶"/>
                                <Setter TargetName="TimeLbl" Property="Foreground" Value="#8A919F"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyHint" Text="双击主窗口任务加入面板" Foreground="#B0B6BF"
                       FontSize="11" Margin="10,4,10,10"/>
        </StackPanel>
    </Border>
</Window>
