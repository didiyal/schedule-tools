<Window x:Class="TodoTimer.Views.TimerPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="计时面板" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <DropShadowEffect x:Key="PanelShadow" BlurRadius="18" ShadowDepth="3"
                          Direction="270" Opacity="0.16"/>
    </Window.Resources>
    <Border CornerRadius="10" Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
            Effect="{StaticResource PanelShadow}">
        <StackPanel>
            <!-- 标题栏（拖动移动；位置持久化） -->
            <Border Background="Transparent" CornerRadius="10,10,0,0" Padding="12,9"
                    MouseLeftButtonDown="Header_DragMove"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="计时面板" Foreground="{StaticResource Brush.TextPrimary}"
                               FontWeight="Bold" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ItemsControl x:Name="PanelList" Margin="8,7,8,2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RowBd" Background="{StaticResource Brush.WindowBg}"
                                CornerRadius="8" Padding="9,6" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               Foreground="{StaticResource Brush.Star}"
                                               VerticalAlignment="Center" Margin="0,0,4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StarVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Todo.Text}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Completed}" Value="True">
                                                        <Setter Property="Foreground" Value="#9AA3AF"/>
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock x:Name="TimeLbl" Tag="time" Grid.Column="1" FontSize="12" Text="{Binding TimeText}"
                                           Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="6,0"/>
                                <Button x:Name="ToggleBtn" Grid.Column="2" Width="26" Height="24"
                                        Style="{StaticResource IconBtn}" Foreground="{StaticResource Brush.Accent}"
                                        FontSize="12" Click="Toggle_Click" Cursor="Hand"/>
                                <Button Grid.Column="3" Width="26" Height="24"
                                        Style="{StaticResource IconBtn}" Foreground="{StaticResource Brush.Success}"
                                        FontSize="12" Content="&#xE73E;"
                                        Click="Complete_Click" Cursor="Hand"/>
                                <Button Grid.Column="4" Width="26" Height="24"
                                        Style="{StaticResource IconBtn}" Foreground="{StaticResource Brush.TextQuaternary}"
                                        FontSize="11" Content="&#xE711;"
                                        Click="Remove_Click" Cursor="Hand"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Running}" Value="True">
                                <Setter TargetName="ToggleBtn" Property="Content" Value="&#xE769;"/>
                                <Setter TargetName="TimeLbl" Property="Foreground" Value="{StaticResource Brush.SuccessText}"/>
                                <Setter TargetName="RowBd" Property="Background" Value="#E8F7EE"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Running}" Value="False">
                                <Setter TargetName="ToggleBtn" Property="Content" Value="&#xE768;"/>
                                <Setter TargetName="TimeLbl" Property="Foreground" Value="{StaticResource Brush.TextTertiary}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyHint" Text="双击主窗口任务加入面板"
                       Foreground="{StaticResource Brush.TextQuaternary}"
                       FontSize="11" Margin="12,4,12,10"/>
        </StackPanel>
    </Border>
</Window>
