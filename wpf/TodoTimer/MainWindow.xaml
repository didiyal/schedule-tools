<Window x:Class="TodoTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办计时器" Height="680" Width="440"
        Background="#F5F6FA" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8A919F"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- 顶部：筛选 + 搜索 -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" Padding="12,8">
            <DockPanel>
                <TextBox DockPanel.Dock="Right" Width="150" FontSize="12"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="筛选" Foreground="#5C626E" FontSize="12" VerticalAlignment="Center"/>
                    <CheckBox Content="未完成" IsChecked="{Binding FilterActive}"
                              Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox Content="已完成" IsChecked="{Binding FilterCompleted}"
                              Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- 输入栏：新建主任务 -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" Padding="12,0,12,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="添加" Width="64" Height="30"
                        Command="{Binding AddCommand}"/>
                <TextBox VerticalContentAlignment="Center" FontSize="13"
                         Text="{Binding NewTodoText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>
        <!-- 底部：统计 + 提示 + 面板开关 -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" Padding="12,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="⏱ 面板" Padding="8,2" Click="PanelBtn_Click"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatText}" Foreground="#8A919F" FontSize="11"/>
                    <TextBlock Text="{Binding Toast}" Foreground="#E8842C" FontSize="11" Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toast}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- 列表（虚拟化 + 选中 + 拖拽 + 快捷键） -->
        <ListBox x:Name="List" ItemsSource="{Binding Rows}"
                 Background="Transparent" BorderThickness="0" Padding="8,4"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 SelectedValuePath="Todo.Id"
                 SelectedValue="{Binding SelectedId}"
                 AllowDrop="True"
                 PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="List_PreviewMouseMove"
                 DragOver="List_DragOver"
                 DragLeave="List_DragLeave"
                 Drop="List_Drop"
                 QueryContinueDrag="List_QueryContinueDrag">
            <ListBox.InputBindings>
                <KeyBinding Key="Tab" Command="{Binding IndentSelectedCommand}"/>
                <KeyBinding Key="Tab" Modifiers="Shift" Command="{Binding OutdentSelectedCommand}"/>
                <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}"/>
                <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoSelectedCommand}"/>
                <KeyBinding Key="Q" Modifiers="Control" Command="{Binding ExitAppCommand}"/>
            </ListBox.InputBindings>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E8F0FE"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <!-- 日组头 -->
                        <TextBlock Text="{Binding Label}" Margin="2,10,2,4"
                                   FontSize="12" FontWeight="Bold" Foreground="#8A919F">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- 任务卡（默认底色必须走 Style Setter：本地属性会压过触发器） -->
                        <Border Margin="{Binding CardMargin}" Padding="10,7" CornerRadius="6"
                                MouseLeftButtonDown="Card_MouseDown">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="完成 / 取消完成" Click="MenuToggleComplete_Click"/>
                                    <MenuItem Header="★ 重点切换" Click="MenuToggleStar_Click"/>
                                    <MenuItem Header="✏ 重命名" Click="MenuRename_Click"/>
                                    <MenuItem Header="➕ 添加子任务" Click="MenuAddChild_Click"/>
                                    <MenuItem Header="⏱ 加入 / 移出计时面板" Click="MenuPanelVisible_Click"/>
                                    <MenuItem Header="🗑 删除（连同子任务）" Click="MenuDelete_Click"/>
                                    <Separator/>
                                    <MenuItem Header="清除已完成（归档）" Command="{Binding DataContext.ArchiveCompletedConfirmedCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Todo.Completed}" Value="True">
                                            <Setter Property="Background" Value="#E8F7EE"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Dim}" Value="True">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 折叠箭头 -->
                                <Button Grid.Column="0" FontSize="11"
                                        Content="{Binding ExpandGlyph}"
                                        Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Todo.Id}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostBtn}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Expandable}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- 重点 -->
                                <TextBlock Grid.Column="1" Text="★" FontSize="12"
                                           Foreground="#F5A623" VerticalAlignment="Center" Margin="2,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Todo.Starred}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- 正文（默认前景走 Style Setter：本地属性会压过触发器） -->
                                <TextBlock Grid.Column="2" Text="{Binding Todo.Text}" FontSize="13"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,0,4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#1F2329"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Todo.Completed}" Value="True">
                                                    <Setter Property="Foreground" Value="#9AA3AF"/>
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- 跨日角标 -->
                                <TextBlock Grid.Column="3" Text="{Binding DateBadge}" FontSize="11"
                                           Foreground="#B0B6BF" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowDate}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- 子进度 -->
                                <TextBlock Grid.Column="4" Text="{Binding Progress}" FontSize="11"
                                           Foreground="#8A919F" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Expandable}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
