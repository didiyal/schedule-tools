<Window x:Class="TodoTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办计时器" Height="640" Width="420"
        Background="#F5F6FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="List" Margin="8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,7" CornerRadius="6" Margin="{Binding Indent}" Background="#FFFFFF">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Completed}" Value="True">
                                        <Setter Property="Background" Value="#E8F7EE"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="2,10,2,4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Label}" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1F2329"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Completed}" Value="True">
                                            <Setter Property="Foreground" Value="#9AA3AF"/>
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter Property="Foreground" Value="#8A919F"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Window>
