<Window x:Class="TodoTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办计时器 1.4" Height="680" Width="440"
        Background="{StaticResource Brush.WindowBg}" FontFamily="Microsoft YaHei UI">
    <DockPanel>
        <!-- 顶部：筛选 + 搜索 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface}" Padding="12,9,12,7">
            <DockPanel>
                <TextBox DockPanel.Dock="Right" Width="150" FontSize="12"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="筛选" Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="12" VerticalAlignment="Center"/>
                    <CheckBox Content="未完成" IsChecked="{Binding FilterActive}" Margin="10,0,0,0"/>
                    <CheckBox Content="已完成" IsChecked="{Binding FilterCompleted}" Margin="12,0,0,0"/>
                    <CheckBox Content="只看今日" IsChecked="{Binding FilterToday}" Margin="12,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- 输入栏：新建主任务（底部分隔线隔开画布） -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface}" Padding="12,0,12,9"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="添加" Width="64" Height="30" Margin="8,0,0,0"
                        Style="{StaticResource BtnPrimary}" Command="{Binding AddCommand}"/>
                <TextBox FontSize="13"
                         Text="{Binding NewTodoText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>
        <!-- 底部：统计 + 提示 + 面板开关 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Surface}" Padding="12,6"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}"
                        Padding="9,3" Click="PanelBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="面板" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatText}" Foreground="{StaticResource Brush.TextTertiary}" FontSize="11"/>
                    <TextBlock Text="{Binding Toast}" Foreground="{StaticResource Brush.Orange}" FontSize="11" Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toast}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- 列表（虚拟化 + 选中 + 拖拽 + 快捷键） -->
        <ListBox x:Name="List" ItemsSource="{Binding Rows}"
                 Background="Transparent" BorderThickness="0" Padding="8,4"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 SelectedValuePath="Todo.Id"
                 SelectedValue="{Binding SelectedId}"
                 PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="List_PreviewMouseMove"
                 PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp">
            <ListBox.InputBindings>
                <KeyBinding Key="Tab" Command="{Binding IndentSelectedCommand}"/>
                <KeyBinding Key="Tab" Modifiers="Shift" Command="{Binding OutdentSelectedCommand}"/>
                <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}"/>
                <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoSelectedCommand}"/>
                <KeyBinding Key="Q" Modifiers="Control" Command="{Binding ExitAppCommand}"/>
            </ListBox.InputBindings>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="#EDF0F5"/>
                                    </MultiTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E5EEFC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <!-- 日组头 -->
                        <TextBlock Text="{Binding Label}" Margin="4,12,2,5"
                                   FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Brush.TextTertiary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- 今日空槽文本（日历图标 + 提示） -->
                        <StackPanel Orientation="Horizontal" Margin="4,8,4,8">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTodaySlot}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{StaticResource Brush.Orange}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Label}" FontSize="12" Margin="6,0,0,0"
                                       Foreground="{StaticResource Brush.Orange}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- 任务卡（默认底色必须走 Style Setter：本地属性会压过触发器；
                             hover 放最前=最低优先级，特殊底色卡不受影响） -->
                        <Border Margin="{Binding CardMargin}" Padding="10,7" CornerRadius="8"
                                MouseLeftButtonDown="Card_MouseDown">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="完成 / 取消完成" Click="MenuToggleComplete_Click">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;"
                                                       FontSize="13" Foreground="{StaticResource Brush.Success}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="重点切换" Click="MenuToggleStar_Click">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE735;"
                                                       FontSize="13" Foreground="{StaticResource Brush.Star}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="重命名" Click="MenuRename_Click">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;"
                                                       FontSize="13" Foreground="{StaticResource Brush.TextSecondary}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="添加子任务" Click="MenuAddChild_Click">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;"
                                                       FontSize="13" Foreground="{StaticResource Brush.Accent}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="加入 / 移出计时面板" Click="MenuPanelVisible_Click">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE823;"
                                                       FontSize="13" Foreground="{StaticResource Brush.Accent}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="删除（连同子任务）" Click="MenuDelete_Click">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;"
                                                       FontSize="13" Foreground="{StaticResource Brush.Danger}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="清除已完成（归档）"
                                              Command="{Binding DataContext.ArchiveCompletedConfirmedCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <!-- hover 微沉底（叶子卡才可见；后面的触发器会盖回各自底色） -->
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="#FBFCFE"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                            <Setter Property="Background" Value="#EDF2F9"/>
                                            <Setter Property="BorderBrush" Value="#A9C1E8"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Height" Value="30"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter Property="Background" Value="#FDECEC"/>
                                            <Setter Property="BorderBrush" Value="#E5484D"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTodaySlot}" Value="True">
                                            <Setter Property="Background" Value="#FFF7E6"/>
                                            <Setter Property="BorderBrush" Value="#F0B268"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                        <!-- 有子任务的父卡三档区分：一级淡蓝底+明显投影，二级更淡底+弱投影，
                                             叶子任务纯白无影。框线不因完成消失（完成只覆盖底色为绿）；
                                             须放在 Completed 之前，完成的底色由完成态触发器覆盖 -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Expandable}" Value="True"/>
                                                <Condition Binding="{Binding Depth}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#E7EFFB"/>
                                            <Setter Property="BorderBrush" Value="#8FB4EA"/>
                                            <Setter Property="BorderThickness" Value="3,1,1,1"/>
                                            <Setter Property="Effect" Value="{StaticResource ParentShadowL1}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Expandable}" Value="True"/>
                                                <Condition Binding="{Binding Depth}" Value="1"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#F1F5FB"/>
                                            <Setter Property="BorderBrush" Value="#CBD9EE"/>
                                            <Setter Property="BorderThickness" Value="2,1,1,1"/>
                                            <Setter Property="Effect" Value="{StaticResource ParentShadowL2}"/>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding Todo.Completed}" Value="True">
                                            <Setter Property="Background" Value="#E8F7EE"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Dim}" Value="True">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTodaySlot}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 折叠箭头 -->
                                <Button Grid.Column="0" FontSize="10" Width="18"
                                        Content="{Binding ExpandGlyph}"
                                        Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Todo.Id}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostBtn}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Expandable}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- 重点（星标实心） -->
                                <TextBlock Grid.Column="1" Text="&#xE735;" FontFamily="{StaticResource IconFont}"
                                           FontSize="11" Foreground="{StaticResource Brush.Star}"
                                           VerticalAlignment="Center" Margin="2,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Todo.Starred}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- 正文（默认前景走 Style Setter：本地属性会压过触发器） -->
                                <TextBlock Grid.Column="2" Text="{Binding Todo.Text}" FontSize="13"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="5,0,4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Todo.Completed}" Value="True">
                                                    <Setter Property="Foreground" Value="#9AA3AF"/>
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- 跨日角标 -->
                                <TextBlock Grid.Column="3" Text="{Binding DateBadge}" FontSize="11"
                                           Foreground="{StaticResource Brush.TextQuaternary}"
                                           VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowDate}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- 子进度（浅灰胶囊） -->
                                <Border Grid.Column="4" CornerRadius="8" Background="#F0F2F6"
                                        Padding="7,1" Margin="2,0,0,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Expandable}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Progress}" FontSize="10.5"
                                               Foreground="{StaticResource Brush.TextSecondary}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
