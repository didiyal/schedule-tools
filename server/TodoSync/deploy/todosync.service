[Unit]
Description=TodoSync - todo timer sync hub (v1.5 S1)
After=network.target

[Service]
Type=simple
User=www
WorkingDirectory=/www/wwwroot/todosync
ExecStart=/www/wwwroot/todosync/TodoSync --data-dir /www/wwwroot/todosync/data
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
